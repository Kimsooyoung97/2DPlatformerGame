# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
NAN2026Game/.utmp/
NAN2026Game/[Ll]ibrary/
NAN2026Game/[Tt]emp/
NAN2026Game/[Oo]bj/
NAN2026Game/[Bb]uild/
NAN2026Game/[Bb]uilds/
NAN2026Game/[Ll]ogs/
NAN2026Game/[Uu]ser[Ss]ettings/
NAN2026Game/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
NAN2026Game/*.blend1
NAN2026Game/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
NAN2026Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
NAN2026Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
NAN2026Game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
NAN2026Game/*.DotSettings.user

# Visual Studio cache directory
NAN2026Game/.vs/

# Gradle cache directory
NAN2026Game/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
NAN2026Game/ExportedObj/
NAN2026Game/.consulo/
NAN2026Game/*.csproj
NAN2026Game/*.unityproj
NAN2026Game/*.sln
NAN2026Game/*.slnx
NAN2026Game/*.suo
NAN2026Game/*.tmp
NAN2026Game/*.user
NAN2026Game/*.userprefs
NAN2026Game/*.pidb
NAN2026Game/*.booproj
NAN2026Game/*.svd
NAN2026Game/*.pdb
NAN2026Game/*.mdb
NAN2026Game/*.opendb
NAN2026Game/*.VC.db

# Unity3D generated meta files
NAN2026Game/*.pidb.meta
NAN2026Game/*.pdb.meta
NAN2026Game/*.mdb.meta

# Unity3D generated file on crash reports
NAN2026Game/sysinfo.txt

# Mono auto generated files
NAN2026Game/mono_crash.*

# Builds
NAN2026Game/*.apk
NAN2026Game/*.aab
NAN2026Game/*.unitypackage
NAN2026Game/*.unitypackage.meta
NAN2026Game/*.app

# Crashlytics generated file
NAN2026Game/crashlytics-build.properties

# TestRunner generated files
NAN2026Game/InitTestScene*.unity*

# Addressables default ignores, before user customizations
NAN2026Game/ServerData
NAN2026Game/[Aa]ssets/StreamingAssets/aa*
NAN2026Game/[Aa]ssets/AddressableAssetsData/link.xml*
NAN2026Game/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
NAN2026Game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
NAN2026Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
NAN2026Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
NAN2026Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
NAN2026Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
NAN2026Game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
NAN2026Game/[Aa]ssets/[Ss]ceneDependencyCache*
