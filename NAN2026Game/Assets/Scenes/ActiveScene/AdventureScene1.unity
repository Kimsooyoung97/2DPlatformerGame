    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "\uC5B4\uB51C \uADF8\uB807\uAC8C \uAE09\uD558\uAC8C \uAC00\uB294\uAC00?\n\uC774
        \uC55E\uC740 \uC704\uD5D8\uD558\uB2E4\uACE0!!"
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[1].text
      value: "\uACF5\uC8FC\uB2D8\uC774 \uB0A9\uCE58 \uB2F9\uD558\uB294 \uAC78 \uBAA9\uACA9\uD588\uC5B4\uC694!!\n\uC5B4\uC11C
        \uBE68\uB9AC \uAD6C\uD558\uB7EC \uAC00\uC57C\uD569\uB2C8\uB2E4.."
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "\uBB50\uB77C\uACE0? \uACF5\uC8FC\uB2D8\uC774?\n\uB0B4\uAC00 \uC9C1\uC811
        \uB3C4\uC640\uC8FC\uAE30\uB294 \uD798\uB4E4\uC9C0\uB9CC,\n\uC774 \uC55E\uC744
        \uD5E4\uCCD0\uB098\uAC08 \uC218 \uC788\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uC8FC\uACA0\uB124"
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[3].text
      value: "\uC694\uC57D\uD574\uC11C \uBE68\uB9AC \uBE68\uB9AC \uB9D0\uD574\uC8FC\uC138\uC694..."
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[4].text
      value: "\"Z\" \uB97C \uB204\uB974\uBA74 \uACF5\uACA9\uD560 \uC218\uC788\uC5B4\n\"
        Space\" \uB97C \uB204\uB974\uBA74 \uD328\uB9C1\uC744 \uD560 \uC218 \uC788\uC5B4\n\"Ctrl\"
        \uB97C \uB204\uB974\uBA74 \uBC31 \uC2A4\uD0ED, \uAD6C\uB974\uAE30\uB97C \uD560
        \uC218 \uC788\uC5B4\n\"1, 2, 3 \" \uC22B\uC790 \uD0A4\uB97C \uB204\uB974\uBA74
        \uC2A4\uD0AC\uC744 \uC4F8 \uC218 \uC788\uB2E4\uB124.."
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[5].text
      value: "\uC5E5 \uC7A0\uC2DC\uB9CC..\n\uC790\uB128 \uB108\uBB34 \uC57D\uD574\uC11C
        \uC2A4\uD0AC\uC774 \uBD09\uC778\uB418\uC5B4 \uC788\uAD6C\uB9CC\n\uC774 \uC55E\uC744
        \uAC00\uB2E4 \uBCF4\uBA74 \uD2B9\uC774\uD55C \uB3CC\uC774 \uC788\uC744 \uAC78\uC138\n\uADF8
        \uAE38\uC744 \uB530\uB77C \uC0C1\uC790\uB97C \uCC3E\uC544 \uBD80\uC154\uBCF4\uAC8C\uB098\n\uADF8\uB7FC
        \uC2A4\uD0AC\uC774 \uD65C\uC131\uD654 \uB420\uAC70\uC57C.."
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[6].text
      value: "\uAE30\uC5B5\uB098\uC9C0 \uC54A\uC73C\uBA74 \uB2E4\uC2DC \uCC3E\uC544
        \uC624\uAC8C\uB098..."
      objectReference: {fileID: 0}
    - target: {fileID: 3449049298426623474, guid: c8a98f0eb061f9c4193a2b287db30866, type: 3}
      propertyPath: lines.Array.data[7].text
      value: "\uC544.. \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9 \uD55C \uAC00\uC9C0
        \uB354 \uC790\uB124 \uB4A4\uC5D0 \uC788\uB294 \uC11D\uC0C1\uC744 \uAF2D \uB9CC\uC838\uBCF4\uAC8C "
